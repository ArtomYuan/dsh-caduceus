{
  "name": "dsh-caduceus",
  "version": "0.9.0",
  "description": "Feishu/Lark surface plugin for DeepSeek Harness (dsh): one topic per session, SOUL persona sync, streaming process cards, /status and /doctor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persona": {
      "types": "./dist/persona/index.d.ts",
      "default": "./dist/persona/index.js"
    },
    "./session-key": {
      "types": "./dist/session-key.d.ts",
      "default": "./dist/session-key.js"
    },
    "./persona/blocks": {
      "types": "./dist/persona/blocks.d.ts",
      "default": "./dist/persona/blocks.js"
    },
    "./commands/parse": {
      "types": "./dist/commands/parse.d.ts",
      "default": "./dist/commands/parse.js"
    },
    "./render/truncate": {
      "types": "./dist/render/truncate.d.ts",
      "default": "./dist/render/truncate.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist .test-dist",
    "prepare": "tsc -p tsconfig.json"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "gateway",
    "surface",
    "bundle",
    "plugin",
    "dsh-plugin",
    "cordis",
    "chat"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "ArtomYuan",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArtomYuan/dsh-caduceus.git"
  },
  "homepage": "https://github.com/ArtomYuan/dsh-caduceus#readme",
  "bugs": {
    "url": "https://github.com/ArtomYuan/dsh-caduceus/issues"
  }
}
