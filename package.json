{
  "name": "@artomyuan/dsh-caduceus",
  "version": "0.1.0",
  "description": "Hermes-style Feishu surface for DeepSeek Harness (dsh): one topic = one session, SOUL persona block, streaming cards. Slice 1: scaffold + pure logic modules.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persona": {
      "types": "./dist/persona/index.d.ts",
      "default": "./dist/persona/index.js"
    },
    "./session-key": {
      "types": "./dist/session-key.d.ts",
      "default": "./dist/session-key.js"
    },
    "./persona/blocks": {
      "types": "./dist/persona/blocks.d.ts",
      "default": "./dist/persona/blocks.js"
    },
    "./commands/parse": {
      "types": "./dist/commands/parse.d.ts",
      "default": "./dist/commands/parse.js"
    },
    "./render/truncate": {
      "types": "./dist/render/truncate.d.ts",
      "default": "./dist/render/truncate.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist .test-dist"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "gateway",
    "surface",
    "bundle",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
